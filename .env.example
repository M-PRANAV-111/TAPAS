# Optional TAPAS scientific API. Empty means explicitly unavailable; no demo fallback.
# Every scientific response must match requested geographic identity and date.
NEXT_PUBLIC_API_URL=
# Required for sourced regional risk polygons; FeatureCollection with source/version/identity.
NEXT_PUBLIC_GEOMETRY_URL=
# Public prototype providers; optional overrides. No secret belongs in NEXT_PUBLIC_*.
NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org
NEXT_PUBLIC_WEATHER_URL=https://api.open-meteo.com/v1/forecast
NEXT_PUBLIC_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional sourced authority inventories and geographically applicable notices.
NEXT_PUBLIC_OFFICIAL_RESOURCES_URL=
NEXT_PUBLIC_OFFICIAL_INFORMATION_URL=
# Optional deployment tile provider. Preserve its required attribution in HeatMap.tsx.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
